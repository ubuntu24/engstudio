# ============================================================
# Sao chép file này thành .env và điền giá trị thật vào
# cp .env.example .env
# ============================================================

# Backend Node.js (cổng 5000)
JWT_SECRET=your-super-secret-jwt-key-here-change-this

# Backend Python Flask (cổng 5001)
FLASK_SECRET_KEY=your-flask-secret-key-here-change-this

# Đường dẫn database (thường không cần thay đổi)
DB_PATH=./database/english_learning.db
TRANSCRIPT_DB_PATH=./database/transcript_cache.db

# URL của Python AI service (mặc định nếu chạy local)
AI_SERVICE_URL=http://127.0.0.1:5001
