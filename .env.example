# ============================================================
# Sao chép file này thành .env và điền giá trị thật vào
# cp .env.example .env
# ============================================================

# ─── SUPABASE (PostgreSQL) ──────────────────────────────────
# Lấy từ: Supabase Dashboard → Project → Settings → Database → Connection string → URI
# Chọn mode "Transaction" (port 6543) để dùng với connection pooling
SUPABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# ─── Backend Node.js (cổng 5000) ────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-here-change-this

# ─── Inter-service Authentication ───────────────────────────
# Shared secret between Node.js proxy and Python backend.
# Python backend will only trust X-User-Id headers that come with this secret.
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=your-internal-api-secret-here-change-this

# ─── Backend Python Flask (cổng 5001) ───────────────────────
FLASK_SECRET_KEY=your-flask-secret-key-here-change-this

# ─── Cloudflare Tunnel Token ────────────────────────────────
# Lấy từ: Cloudflare Zero Trust → Networks → Tunnels → tên tunnel → Configure → Token
CF_TUNNEL_TOKEN=your-cloudflare-tunnel-token-here

# ─── URL public của app (frontend gọi API) ──────────────────
NEXT_PUBLIC_API_URL=https://your-domain.com
